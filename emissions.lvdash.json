{
  "datasets": [
    {
      "name": "f6ca9bd4",
      "displayName": "location",
      "queryLines": [
        "SELECT latitude, longitude,\r\n",
        "`GHG emissions mtons CO2e` AS emissions\r\n",
        "FROM emissions_data"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "aa587306",
      "displayName": "emission per person",
      "queryLines": [
        "SELECT\r\n",
        "  county_state_name,\r\n",
        "  population,\r\n",
        "  (CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population) AS emission_per_person\r\n",
        "FROM\r\n",
        "  emissions.default.emissions_data\r\n",
        "WHERE\r\n",
        "  population > 0\r\n",
        "ORDER BY\r\n",
        "  emission_per_person DESC\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "09cf2365",
      "displayName": "top_states",
      "queryLines": [
        "SELECT\r\n",
        "   state_abbr,\r\n",
        "  SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population) AS Total_emission\r\n",
        "FROM\r\n",
        "  emissions.default.emissions_data\r\n",
        "WHERE\r\n",
        "  population > 0\r\n",
        "GROUP BY\r\n",
        "  state_abbr\r\n",
        "ORDER BY\r\n",
        "  Total_emission DESC\r\n",
        "LIMIT\r\n",
        "  10"
      ]
    },
    {
      "name": "4abfbbac",
      "displayName": "county",
      "queryLines": [
        "SELECT\r\n",
        "   county_state_name,\r\n",
        "   population,\r\n",
        "  CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS Total_emission\r\n",
        "FROM\r\n",
        "  emissions.default.emissions_data\r\n",
        "WHERE\r\n",
        "  population > 0\r\n",
        "ORDER BY\r\n",
        "  Total_emission DESC\r\n",
        "LIMIT\r\n",
        "  10"
      ]
    }
  ],
